NODE_ENV=development

# Which profile in ~/.config/fd/config.json to use (default: "local")
FD_PROFILE=local

# Org slug per profile, for composing thread URLs. The CLI never reads these —
# they exist so the caller can build a support URL from a created thread.
FD_LOCAL_ORG_SLUG=acme
FD_PROD_ORG_SLUG=
