NODE_ENV=development
# Google Generative AI (embeddings only)
GOOGLE_GENERATIVE_AI_API_KEY=

# Respan gateway (all text generation, including Jev)
RESPAN_API_KEY=
# Optional. Required for Jev unless a TypeSafe key is saved in Respan Settings > Providers.
TYPESAFE_AI_API_KEY=
REFLAG_SECRET_KEY=
PR_MATCH_CANDIDATE_LIMIT=20
PR_MATCH_RETRIEVAL_FLOOR=0.7
PR_MATCH_RERANK_THRESHOLD=0.85