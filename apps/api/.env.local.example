NODE_ENV=development
BETTER_AUTH_SECRET=
BASE_FRONTEND_URL=

# This is a key shared between the API, Discord bot, and local fd devtool CLI
DISCORD_BOT_KEY=
# Dedicated secret shared only by the API and connector host for credential
# reads/writes and OAuth completion.
CONNECTOR_HOST_SECRET=
# Salt used when hashing private API keys. Required outside development.
API_KEY_SALT=
# Master key used to derive versioned per-organization widget signing secrets.
# Keep it server-side. Integrators receive only their organization's derived
# FRONTDESK_SECRET_KEY value.
FRONTDESK_WIDGET_SIGNING_MASTER_KEY=
# AES-256-GCM keyring for encrypted integration credentials. Keep server-side.
# INTEGRATION_CREDENTIAL_KEYS maps key ids to base64-encoded 32-byte AES keys;
# INTEGRATION_CREDENTIAL_CURRENT_KEY_ID must name one of those ids.
# Both variables are required when integration credentials are read or written.
INTEGRATION_CREDENTIAL_CURRENT_KEY_ID=
INTEGRATION_CREDENTIAL_KEYS=
# Optional webhook for notifications about new public waitlist signups
DISCORD_WAITLIST_WEBHOOK_URL=
RESEND_API_KEY=

# Google OAuth
ENABLE_GOOGLE_LOGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Qdrant
QDRANT_URL=http://localhost:6333

# Optional: API port (defaults to 3333 if not set)
PORT=

# Google Generative AI (embeddings only)
GOOGLE_GENERATIVE_AI_API_KEY=

# Respan gateway (all text generation)
RESPAN_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Reflag (Feature Flags)
REFLAG_SECRET_KEY=
