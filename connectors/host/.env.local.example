PORT=3336
# Shared connector-invocation key; must match apps/api DISCORD_BOT_KEY.
DISCORD_BOT_KEY=discord_secret
# Dedicated API credential/OAuth secret; must match apps/api CONNECTOR_HOST_SECRET.
CONNECTOR_HOST_SECRET=connector_host_secret
LIVE_STATE_API_URL=http://localhost:3333/api/ls
LIVE_STATE_WS_URL=ws://localhost:3333/api/ls/ws
BASE_FRONTEND_URL=http://localhost:3000
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3336/linear/api/oauth/callback
# Required when Linear OAuth is configured; the connector stays disabled if blank.
LINEAR_WEBHOOK_SECRET=
